{
  "name": "felar",
  "version": "1.0.0",
  "description": "Felar — a Discord-like real-time messenger (web, desktop & mobile)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "desktop": "electron desktop/main.js",
    "desktop:build": "electron-builder",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
  "keywords": [
    "messenger",
    "chat",
    "websocket",
    "discord",
    "electron",
    "capacitor"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  },
  "build": {
    "appId": "com.felar.app",
    "productName": "Felar",
    "files": [
      "desktop/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "win": { "target": "nsis", "icon": "public/assets/icons/app-icon.png" },
    "mac": { "target": "dmg", "icon": "public/assets/icons/app-icon.png" },
    "linux": { "target": "AppImage", "icon": "public/assets/icons/app-icon.png" }
  }
}
