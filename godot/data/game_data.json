 "DIALOGUES": {
  "1": {
   "1": [
    {
     "who": "Мотылёк",
     "text": "Люм, проснись! Звезда упала… и лес начал гаснуть."
    },
    {
     "who": "Мотылёк",
     "text": "Собирай осколки света — только они смогут вернуть зарю."
    },
    {
     "who": "Мотылёк",
     "text": "Стрелки или A/D — идти, Пробел — прыжок. Вперёд!"
    }
   ],
   "2": [
    {
     "who": "Мотылёк",
     "text": "Осколки тянутся к тебе. Не оставляй их во тьме — наверху их больше."
    }
   ],
   "3": [
    {
     "who": "Мотылёк",
     "text": "Слышишь шёпот? Тени стали смелее…"
    },
    {
     "who": "Мотылёк",
     "text": "Прыгай им прямо на макушку — света они не выносят!"
    }
   ],
   "4": [
    {
     "who": "Мотылёк",
     "text": "Врата ещё дышат светом. За ними — Хрустальные пещеры."
    },
    {
     "who": "Мотылёк",
     "text": "Готов? Тогда шагай в сияние."
    }
   ]
  },
  "2": {
   "1": [
    {
     "who": "Мотылёк",
     "text": "Здесь эхо ещё помнит небо… Чувствуешь дрожь кристаллов?"
    },
    {
     "who": "Мотылёк",
     "text": "Их свет дарит тебе ДВОЙНОЙ ПРЫЖОК! Нажми прыжок ещё раз в воздухе."
    }
   ],
   "2": [
    {
     "who": "Мотылёк",
     "text": "Не касайся сталактитов. Они острее старых обид."
    }
   ],
   "3": [
    {
     "who": "Мотылёк",
     "text": "Пещеры поют… Значит, Сердце Небес ещё живо. Поднимайся выше!"
    }
   ],
   "4": [
    {
     "who": "Мотылёк",
     "text": "Выход к небу! Держись, Люм, осталась последняя дорога."
    }
   ]
  },
  "3": {
   "1": [
    {
     "who": "Мотылёк",
     "text": "Цитадель… Мы почти у цели. Слышишь, как гудит ветер?"
    },
    {
     "who": "Мотылёк",
     "text": "Он дарит тебе РЫВОК! Жми Shift или X — и лети через пропасти."
    }
   ],
   "2": [
    {
     "who": "Мотылёк",
     "text": "Внизу — только небо. Не смотри вниз. Смотри вперёд."
    }
   ],
   "3": [
    {
     "who": "Мотылёк",
     "text": "Стражи забыли, кому служат. Освободи их от тьмы — прыжком сверху."
    }
   ],
   "4": [
    {
     "who": "Мотылёк",
     "text": "Сердце Небес — за этими вратами. Верни ему свет, Люм."
    },
    {
     "who": "Мотылёк",
     "text": "…что бы ни случилось — я рядом."
    }
   ]
  }
 },
 "TILESET_COUNT": 6
