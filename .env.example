# Copy to .env and fill in real values:  cp .env.example .env
#
# Port the Node server listens on (behind nginx/Caddy this stays internal).
PORT=3000

# Secret used to sign login tokens. MUST be long and random in production.
# Generate one:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file is stored (absolute path recommended in prod).
ROOST_DB=/opt/roost/data/roost.db
