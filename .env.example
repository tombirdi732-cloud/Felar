# База данных. Для разработки — SQLite, в продакшне — PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/felar"
DATABASE_URL="file:./dev.db"

# Публичный адрес сайта (для OAuth-редиректов и SEO-метатегов)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# VK ID (OAuth VK) — основной способ входа.
# Создайте приложение на https://id.vk.com/ и укажите redirect:
# {NEXT_PUBLIC_SITE_URL}/api/auth/vk/callback
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""

# SMS-провайдер для подтверждения телефона (резервный вход).
# Пока не подключён (SMS_PROVIDER="dev") — код выводится в консоль сервера.
SMS_PROVIDER="dev"
SMS_API_KEY=""

# Телефон, который при подтверждении получает права администратора
# (первичное назначение админа; далее — через админ-панель).
ADMIN_PHONE=""
